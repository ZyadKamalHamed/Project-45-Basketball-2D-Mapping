.env
.python-version
venv/
.DS_Store

# Python build artefacts
__pycache__/
*.pyc

# Training datasets (downloaded on first notebook run)
Data/*.zip
Data/Basketball and net detection.v1i.yolo26/
Data/basketball-court-detection-2.v1-1.yolov8/
Data/basketball-player-detection-3.v1-1.yolo26/

# Bridge runtime artefacts (uploaded videos + generated JSON / PNG / annotated MP4)
GUI/tmp/

# Auto-regenerated by the CVM notebook on every run, no need to track.
cvm_data.yaml

# Trained weights ARE committed to weights/ so the grader can run the pipeline
# without re-training. The only weight-folder things we leave out are Ultralytics'
# built-in demo images and stray detect-test outputs that show up if anyone calls
# model.predict() without a `source` argument.
weights/runs/detect/predict*/
weights/runs/detect/train/

# Local test videos (large, not part of the deliverable)
test_videos/

# Reference material and assistant tooling
example + guidlines/
.claude/
GUI/AGENTS.md
GUI/CLAUDE.md
DEFENSE_NOTES.md